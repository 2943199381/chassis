{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "build",
			"command": "${command:st-stm32-ide-debug-launch.build}",
			"args": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "flash-with-openocd",
			"command": "openocd",
			"args": [
				"-f",
				"openocd.cfg",
				"-c",
				"program ${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1} verify reset exit"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"dependsOn": [
				"build"
			]
		},
		 {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/Release",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release",
        "--config",
        "Release"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (STM32 extension)",
      "type": "shell",
      "command": "${command:st-stm32-ide-debug-launch.build}",
      "args": [],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "OpenOCD: Flash",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/openocd.cfg",
        "-c",
        "program ${workspaceFolder}/build/Release/nRF24L01_ctrl.elf verify reset; shutdown"
      ],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Flash (STM32 extension)",
      "type": "shell",
      "command": "openocd",
      "args": [
       "-f",
        "${workspaceFolder}/openocd.cfg",
        "-c",
        "program ${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1} verify reset exit"
      ],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": [],
  "dependsOn": ["Build (STM32 extension)"]
    },
    {
      "label": "Clean build dir",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/Release", "--target", "clean"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
	]
}